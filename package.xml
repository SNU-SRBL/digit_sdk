<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypealias="format3"?>
<package format="3">
  <name>digit_sdk</name>
  <version>1.0.0</version>
  <description>Digit SDK for tactile sensor data processing and streaming</description>
  
  <maintainer email="bhsong@snu.ac.kr">bhsong</maintainer>
  <license>GPL-3.0-only</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
